---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- assign documents = site.posts | concat: site.html_pages -%}
  {%- assign urls = '' | split: '' -%}
  {%- for document in documents -%}
    {%- if document.sitemap == false or document.redirect_to -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign url = document.url | replace: '/index.html', '/' | absolute_url -%}
    {%- if urls contains url -%}
      {%- continue -%}
    {%- endif -%}
    {%- if document.canonical_url and document.canonical_url != url -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign urls = urls | push: url %}

  <url>
    <loc>{{ url | xml_escape }}</loc>
    {%- if document.last_modified_at %}
    <lastmod>{{ document.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
  {%- endfor %}
</urlset>
